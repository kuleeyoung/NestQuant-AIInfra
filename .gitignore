# Local model and dataset caches at the repository root; never commit gated
# weights or datasets. Leading slashes keep source packages such as
# nestquant/models and tests/unit/models trackable.
/models/
/data/
/cache/
/artifacts/
.cache/

# Local run products; retain small, reviewed summaries under results/.
results/raw/
*.safetensors
*.pt
*.pth
*.ckpt

# Secrets and local tools
.env
.env.*
*.pem
.vscode/
.idea/
.DS_Store
Thumbs.db
