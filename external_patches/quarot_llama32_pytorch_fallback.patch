diff --git a/tests/test_gqa_k_cache.py b/tests/test_gqa_k_cache.py
new file mode 100644
index 0000000..70a2ef2
--- /dev/null
+++ b/tests/test_gqa_k_cache.py
@@ -0,0 +1,47 @@
+import sys
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+
+import torch
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "fake_quant"))
+from rotation_utils import QKRotationWrapper
+
+
+class GQAKCacheTest(unittest.TestCase):
+    def _wrapper(self, bits):
+        config = SimpleNamespace(
+            hidden_size=2048,
+            num_attention_heads=32,
+            num_key_value_heads=8,
+        )
+
+        def rope(q, k):
+            return q, k
+
+        return QKRotationWrapper(
+            rope,
+            config,
+            k_bits=bits,
+            k_groupsize=-1,
+            k_sym=True,
+            k_clip_ratio=1.0,
+        )
+
+    def test_gqa_tokenwise_k_quantization_preserves_shapes(self):
+        torch.manual_seed(58)
+        q = torch.randn(1, 32, 3, 64)
+        k = torch.randn(1, 8, 3, 64)
+        q_out, k_out = self._wrapper(bits=4)(q, k)
+        self.assertEqual(q_out.shape, q.shape)
+        self.assertEqual(k_out.shape, k.shape)
+        self.assertTrue(torch.isfinite(k_out).all())
+
+    def test_gqa_width_uses_kv_heads(self):
+        wrapper = self._wrapper(bits=4)
+        self.assertEqual(wrapper.kv_hidden_size, 8 * 64)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_hadamard_backend.py b/tests/test_hadamard_backend.py
new file mode 100644
index 0000000..a6b39eb
--- /dev/null
+++ b/tests/test_hadamard_backend.py
@@ -0,0 +1,50 @@
+import sys
+import unittest
+from pathlib import Path
+
+import torch
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "fake_quant"))
+import hadamard_utils
+
+
+class PortableHadamardTest(unittest.TestCase):
+    def test_reference_matches_existing_power_of_two_implementation(self):
+        torch.manual_seed(58)
+        x = torch.randn(3, 32, dtype=torch.float64)
+        expected = hadamard_utils.matmul_hadU(x)
+        actual = hadamard_utils.normalized_hadamard_transform(x)
+        torch.testing.assert_close(actual, expected, rtol=1e-7, atol=1e-7)
+
+    def test_transform_is_orthonormal_and_self_inverse(self):
+        torch.manual_seed(58)
+        x = torch.randn(2, 4, 16, dtype=torch.float64)
+        transformed = hadamard_utils.normalized_hadamard_transform(x)
+        recovered = hadamard_utils.normalized_hadamard_transform(transformed)
+        torch.testing.assert_close(recovered, x, rtol=1e-7, atol=1e-7)
+        torch.testing.assert_close(
+            torch.linalg.vector_norm(transformed, dim=-1),
+            torch.linalg.vector_norm(x, dim=-1),
+            rtol=1e-12,
+            atol=1e-12,
+        )
+
+    def test_fallback_supports_composite_hadamard_dimension(self):
+        torch.manual_seed(58)
+        x = torch.randn(2, 12, dtype=torch.float64)
+        had_k, k = hadamard_utils.get_hadK(12)
+        expected = hadamard_utils.matmul_hadU(x)
+        actual = hadamard_utils.matmul_hadU_cuda(x, had_k, k)
+        torch.testing.assert_close(actual, expected, rtol=1e-7, atol=1e-7)
+
+    @unittest.skipUnless(torch.cuda.is_available(), "CUDA is unavailable")
+    def test_reference_runs_on_cuda_bfloat16(self):
+        torch.manual_seed(58)
+        x = torch.randn(2, 32, device="cuda", dtype=torch.bfloat16)
+        transformed = hadamard_utils.normalized_hadamard_transform(x)
+        recovered = hadamard_utils.normalized_hadamard_transform(transformed)
+        torch.testing.assert_close(recovered, x, rtol=2e-2, atol=2e-2)
+
+
+if __name__ == "__main__":
+    unittest.main()
