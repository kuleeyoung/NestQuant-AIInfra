+def normalized_hadamard_transform(X):
+    """Apply an orthonormal Walsh-Hadamard transform on the last axis.
+
+    This portable reference backend uses regular PyTorch operations so the
+    fake-quant path can run without QuaRot's optional CUDA extension.
+    """
+    n = X.shape[-1]
+    assert is_pow2(n), f"Hadamard dimension must be a power of two, got {n}"
+    original_shape = X.shape
+    output = X.reshape(-1, n).contiguous()
+    width = 1
+    while width < n:
+        output = output.reshape(-1, n // (2 * width), 2, width)
+        left = output[:, :, 0, :]
+        right = output[:, :, 1, :]
+        output = torch.cat((left + right, left - right), dim=-1)
+        width *= 2
+    return output.reshape(original_shape) / math.sqrt(n)
+
