  "stages": {
    "smoke": [
      {
        "name": "Run unit tests without model download",
        "command": ["{python}", "-m", "unittest", "discover", "-s", "tests", "-v"]
      },
      {
        "name": "Run deterministic toy matrix-product smoke",
        "command": [
          "{python}", "scripts/run_synthetic_matrix_product.py",
          "--n", "8", "--m", "8", "--k", "16", "--seed", "58",
          "--device", "cpu", "--output", "results/raw/reproduction_toy_smoke.json"
        ],
        "expected_outputs": ["results/raw/reproduction_toy_smoke.json"]
      }
    ],
    "full": [
      {
        "name": "Collect shared128 grouped Hessians",
        "command": [
          "{python}", "scripts/collect_llama_hessian_groups.py",
          "--chunks", "128", "--layers", "16", "--layers-per-group", "4",
          "--output-dir", "results/raw/calibration/shared128", "--offline",
          "--calibration-manifest", "configs/calibration/llama32_1b_wikitext2_train_seed58_n128.json"
        ],
        "expected_outputs": [
          "results/raw/calibration/shared128/hessian_layers00_03_train128.pt",
          "results/raw/calibration/shared128/hessian_layers00_03_train128.pt.json",
          "results/raw/calibration/shared128/hessian_layers04_07_train128.pt",
