          "results/raw/calibration/shared128/hessian_lm_head_train128.pt.json"
        ]
      },
      {
        "name": "Quantize shared128 W4 and export NQMC",
        "command": [
          "{python}", "scripts/evaluate_llama_wikitext_ppl.py",
          "--methods", "nestquant_w4", "--device", "cuda", "--offline",
          "--ldlq-hessian-dir", "results/raw/calibration/shared128",
          "--ldlq-calibration-chunks", "128", "--exclude-linear", "lm_head",
          "--eval-batch-size", "4",
          "--export-checkpoint", "results/raw/reproduction_shared128_w4.nqmc",
          "--output", "results/raw/reproduction_shared128_w4_export.json"
        ],
        "expected_outputs": [
          "results/raw/reproduction_shared128_w4.nqmc",
          "results/raw/reproduction_shared128_w4_export.json"
        ]
      },
      {
        "name": "Evaluate W4 from the saved NQMC",
        "command": [
          "{python}", "scripts/evaluate_llama_wikitext_ppl.py",
          "--methods", "nestquant_w4", "--device", "cuda", "--offline",
          "--exclude-linear", "lm_head", "--eval-batch-size", "4",
          "--load-checkpoint", "results/raw/reproduction_shared128_w4.nqmc",
          "--output", "results/raw/reproduction_shared128_w4.json"
        ],
        "expected_outputs": ["results/raw/reproduction_shared128_w4.json"]
      },
      {
        "name": "Evaluate W4KV4 from the same NQMC",
        "command": [
          "{python}", "scripts/evaluate_llama_wikitext_ppl.py",
          "--methods", "nestquant_w4", "--device", "cuda", "--offline",
          "--exclude-linear", "lm_head", "--eval-batch-size", "4", "--kv4",
          "--kv-beta-config", "configs/kv_betas_upstream_defaults_q14.json",
          "--load-checkpoint", "results/raw/reproduction_shared128_w4.nqmc",
          "--output", "results/raw/reproduction_shared128_w4kv4.json"
