          "{python}", "scripts/evaluate_llama_wikitext_ppl.py",
          "--methods", "nestquant_w4", "--device", "cuda", "--offline",
          "--exclude-linear", "lm_head", "--eval-batch-size", "4", "--a4",
          "--load-checkpoint", "results/raw/reproduction_shared128_w4.nqmc",
          "--output", "results/raw/reproduction_shared128_w4a4.json"
        ],
        "expected_outputs": ["results/raw/reproduction_shared128_w4a4.json"]
